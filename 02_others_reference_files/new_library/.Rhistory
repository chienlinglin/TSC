#### Global
## function
# GFF Attribute
lh_gff_attr <- function(range_tbl, nm, typ = c("gene", "mRNA", "exon", "LibSeq")){
ID <- range_tbl[["ID"]]
num <- strsplit(nm, "_")[[1]][2]
attr <- switch(typ,
gene = {return(sprintf("ID=%s", ID))},
mRNA = {return(sprintf("Parent=%s;ID=%s", ID, paste0("m", ID)))},
exon = {return(sprintf("Parent=%s;ID=%s", paste0("m", ID), paste0("m", ID, ":", num)))},
LibSeq = {return(sprintf("Parent=%s;ID=%s", paste0("m", ID), paste0("m", ID, ":LibSeq")))}
)
return(attr)
}
View(lh_gff_attr)
